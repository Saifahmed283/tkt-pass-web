# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/tkt_pass?sslmode=require

# Long random string used to sign guest ticket links (min 32 chars)
TICKET_SIGNING_SECRET=replace-with-a-long-random-secret

# Shared password for the /admin dashboard
ADMIN_SECRET=replace-with-admin-password

# Long random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=replace-with-another-long-random-secret

# Gmail SMTP sender (enable 2-Step Verification and create an App Password)
GMAIL_USER=your.tkt.info@gmail.com
GMAIL_APP_PASSWORD=16-char-app-password

# Bulk send pacing / daily cap
DAILY_SEND_LIMIT=400
SEND_DELAY_MS=1500

# Public site URL used in emails
SITE_URL=https://tkt-pass.vercel.app
